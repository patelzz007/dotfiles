<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GitHub Dark: syntax colours matching github.com's dark theme (Primer "dark default").
  Used by bat (cat, previews) and delta (git diffs). Linked into ~/.config/bat/themes
  by install.sh; rebuild bat's cache after editing:  bat cache --build
-->
<plist version="1.0">
<dict>
    <key>name</key>
    <string>GitHub Dark</string>
    <key>settings</key>
    <array>
        <dict>
            <key>settings</key>
            <dict>
                <key>background</key>    <string>#0d1117</string>
                <key>foreground</key>    <string>#e6edf3</string>
                <key>caret</key>         <string>#e6edf3</string>
                <key>lineHighlight</key> <string>#161b22</string>
                <key>selection</key>     <string>#264f78</string>
                <key>gutterForeground</key> <string>#6e7681</string>
            </dict>
        </dict>
        <dict>
            <key>name</key> <string>Comment</string>
            <key>scope</key> <string>comment, punctuation.definition.comment, string.comment</string>
            <key>settings</key> <dict><key>foreground</key> <string>#8b949e</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Constant, language variable, numbers</string>
            <key>scope</key> <string>constant, entity.name.constant, variable.other.constant, variable.other.enummember, variable.language, entity, support.constant</string>
            <key>settings</key> <dict><key>foreground</key> <string>#79c0ff</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Entity names (types, classes)</string>
            <key>scope</key> <string>entity.name, meta.export.default, meta.definition.variable, entity.name.type, entity.other.inherited-class</string>
            <key>settings</key> <dict><key>foreground</key> <string>#ffa657</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Plain variables and parameters</string>
            <key>scope</key> <string>variable.parameter.function, meta.jsx.children, meta.block, meta.tag.attributes, entity.name.constant, meta.object.member, meta.embedded.expression, variable.other, variable.parameter</string>
            <key>settings</key> <dict><key>foreground</key> <string>#e6edf3</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Functions</string>
            <key>scope</key> <string>entity.name.function, support.function, meta.function-call entity.name.function, variable.function</string>
            <key>settings</key> <dict><key>foreground</key> <string>#d2a8ff</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Tags</string>
            <key>scope</key> <string>entity.name.tag, support.class.component</string>
            <key>settings</key> <dict><key>foreground</key> <string>#7ee787</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Keywords and storage</string>
            <key>scope</key> <string>keyword, storage, storage.type, storage.modifier, keyword.operator.new, keyword.control</string>
            <key>settings</key> <dict><key>foreground</key> <string>#ff7b72</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Operators and punctuation</string>
            <key>scope</key> <string>keyword.operator.assignment, keyword.operator.arithmetic, keyword.operator.comparison, keyword.operator.logical, keyword.operator.relational</string>
            <key>settings</key> <dict><key>foreground</key> <string>#ff7b72</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Import / package names</string>
            <key>scope</key> <string>storage.modifier.package, storage.modifier.import, storage.type.java</string>
            <key>settings</key> <dict><key>foreground</key> <string>#e6edf3</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Strings</string>
            <key>scope</key> <string>string, punctuation.definition.string, string punctuation.section.embedded source, string.regexp</string>
            <key>settings</key> <dict><key>foreground</key> <string>#a5d6ff</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>String escapes, regex groups</string>
            <key>scope</key> <string>constant.character.escape, string.regexp constant.character.escape, string.regexp source.ruby.embedded</string>
            <key>settings</key> <dict><key>foreground</key> <string>#7ee787</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Support (built-ins), object keys</string>
            <key>scope</key> <string>support, meta.property-name, support.type.property-name, meta.object-literal.key</string>
            <key>settings</key> <dict><key>foreground</key> <string>#79c0ff</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Variables (special)</string>
            <key>scope</key> <string>variable, variable.other.readwrite.global</string>
            <key>settings</key> <dict><key>foreground</key> <string>#ffa657</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Markdown headings</string>
            <key>scope</key> <string>markup.heading, markup.heading entity.name</string>
            <key>settings</key> <dict><key>foreground</key> <string>#79c0ff</string><key>fontStyle</key> <string>bold</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Markdown emphasis</string>
            <key>scope</key> <string>markup.italic</string>
            <key>settings</key> <dict><key>foreground</key> <string>#e6edf3</string><key>fontStyle</key> <string>italic</string></dict>
        </dict>
        <dict>
            <key>scope</key> <string>markup.bold</string>
            <key>settings</key> <dict><key>foreground</key> <string>#e6edf3</string><key>fontStyle</key> <string>bold</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Markdown code and links</string>
            <key>scope</key> <string>markup.raw, markup.inline.raw, markup.underline.link</string>
            <key>settings</key> <dict><key>foreground</key> <string>#79c0ff</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Markdown lists and quotes</string>
            <key>scope</key> <string>punctuation.definition.list.begin, markup.quote, beginning.punctuation.definition.list</string>
            <key>settings</key> <dict><key>foreground</key> <string>#ffa657</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Diff inserted / deleted / changed</string>
            <key>scope</key> <string>markup.inserted, meta.diff.header.to-file, punctuation.definition.inserted</string>
            <key>settings</key> <dict><key>foreground</key> <string>#aff5b4</string></dict>
        </dict>
        <dict>
            <key>scope</key> <string>markup.deleted, meta.diff.header.from-file, punctuation.definition.deleted</string>
            <key>settings</key> <dict><key>foreground</key> <string>#ffdcd7</string></dict>
        </dict>
        <dict>
            <key>scope</key> <string>markup.changed, punctuation.definition.changed</string>
            <key>settings</key> <dict><key>foreground</key> <string>#ffdfb6</string></dict>
        </dict>
        <dict>
            <key>name</key> <string>Invalid</string>
            <key>scope</key> <string>invalid.illegal, invalid.broken, invalid.deprecated, invalid.unimplemented</string>
            <key>settings</key> <dict><key>foreground</key> <string>#ffa198</string><key>fontStyle</key> <string>italic</string></dict>
        </dict>
    </array>
</dict>
</plist>
